rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules → Publish.
//
// - Any artist can sign in with Google and gets their own studio profile (artists/{their uid}).
// - Artists can only see, edit and delete parcels they created.
// - Clients don't sign in: they can open exactly one parcel if they know its tracking number,
//   plus the public look of that artist's studio (name, handle, colors).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function str(v, max) { return v is string && v.size() <= max; }

    match /artists/{uid} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && str(request.resource.data.studioName, 60)
        && str(request.resource.data.handle, 30)
        && str(request.resource.data.headline, 60)
        && str(request.resource.data.thanks, 160)
        && str(request.resource.data.prefix, 5)
        && request.resource.data.theme is map
        && request.resource.data.defaultStages is list
        && request.resource.data.defaultStages.size() <= 20;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /parcels/{code} {
      function ownsIt() { return signedIn() && resource.data.ownerId == request.auth.uid; }
      function validParcel() {
        let d = request.resource.data;
        return d.ownerId == request.auth.uid
          && str(d.title, 120) && str(d.client, 120) && str(d.artist, 80) && str(d.eta, 10)
          && d.stages is list && d.stages.size() <= 40;
      }

      allow get: if true;                      // a client opening their tracking link
      allow list: if ownsIt();                 // an artist listing their own parcels
      allow create: if signedIn() && validParcel()
        && code.matches('^[A-Z0-9][A-Z0-9-]{2,29}$');
      allow update: if ownsIt() && validParcel();
      allow delete: if ownsIt();

      match /images/{imageId} {
        function ownsParcel() {
          return signedIn() && get(/databases/$(database)/documents/parcels/$(code)).data.ownerId == request.auth.uid;
        }
        allow read: if true;
        allow create: if ownsParcel()
          && request.resource.data.src is string
          && request.resource.data.stageId is string;
        allow update, delete: if ownsParcel();
      }
    }

    // Anything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
